    "dotenv": "^18.0.6",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@google/adk-devtools": "^2.1.0",
    "@types/node": "^26.6.4",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}

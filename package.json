{
  "name": "kleinanzeigen-agent",
  "version": "1.0.0",
  "description": "Hands-on tutorial: build an AI agent with Google's Agent Development Kit (ADK) for TypeScript, one chapter at a time.",
  "license": "MIT",
  "author": "Lukas Zech (https://github.com/lukas-zech-software)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukas-zech-software/kleinanzeigen-agent.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run check:apis && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:apis && npm run check:adk-version && npm run typecheck && npm run format:check",
    "check:apis": "scripts/check-banned-apis.sh",
    "check:adk-version": "scripts/check-adk-version.sh",
    "test:offline": "tsx scripts/test-offline.ts && tsx scripts/test-offline-chapter-02.ts",
    "test:agents": "tsx scripts/test-agents.ts",
    "agent:vision": "adk run adk/vision_inspector.ts --replay examples/replays/vision-inspector.json --log_level warn",
    "agent:price": "adk run adk/price_evaluator.ts --replay examples/replays/price-evaluator.json --log_level warn",
    "agent:listing": "adk run adk/listing_agent.ts --replay examples/replays/listing-agent.json --save_session --session_id listing-agent --log_level warn",
    "agent:web": "adk web adk",
    "session:check": "tsx scripts/check-session.ts adk/listing-agent.session.json"
  },
  "dependencies": {
    "@google/adk": "2.3.0",
    "dotenv": "^18.0.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "devDependencies": {
    "@google/adk-devtools": "2.3.0",
    "@types/node": "^26.6.4",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "overrides": {
    "tedious": "^20.3.7"
  }
}
